# Base URL of the Shikaar FastAPI backend. Copy this file to .env.local.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Accounts mode (optional) ---
# Set both to turn on real sign-in (Supabase). Leave blank to stay in the
# shared-password demo. Find them in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
